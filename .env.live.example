# Copy to .env.live and fill in real values. .env.live is gitignored.
export CF_ACCOUNT_ID=""
export CF_API_TOKEN=""
export CF_TEST_ZONE="example.com"

# Optional: set this when the token can manage DNS in the zone but cannot list
# zones. CF_TEST_ZONE must still be the DNS suffix used for smoke hostnames.
export CF_ZONE_ID=""

# Optional tunnel private-route smoke CIDRs. Override if these collide with
# existing Cloudflare private network routes in the test account.
export CF_SMOKE_ROUTE_CIDR="100.64.207.0/24"
export CF_SMOKE_ROUTE_CONFLICT_CIDR="100.64.208.0/24"

# Optional --site-id for the operator under test. The DR failover smoke
# (hack/live-cloudflare-local.sh failover) writes this into the lease record;
# defaults to a per-run value. The lease reuses the existing Zone:DNS:Edit
# scope, so no extra token permissions are needed.
export SITE_ID=""

# Optional local Kubernetes and image overrides.
export OPERATOR_NAMESPACE="cfzt-system"
export SMOKE_NAMESPACE="cfzt-smoke"
export KIND_CLUSTER="cfzt-live-local"
export IMAGE_REPOSITORY="cfzt-operator"
export IMAGE_TAG="live-local"
export CHART_REF="charts/cfzt-operator"

# Local Docker runtime: auto prefers Colima when installed, otherwise uses the
# current Docker context. Use "colima" to require Colima or "docker" to require
# an already-running Docker daemon.
export LOCAL_DOCKER_RUNTIME="auto"
export COLIMA_PROFILE="default"
export COLIMA_START_ARGS="--cpu 4 --memory 8"
